{
  "name": "webcraft-content-automation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Research tools and a Notion-driven voiceover production queue, built for WebCraft.",
  "author": "Mohamed Yassine Turki",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/cli.js",
    "demo": "node src/demo.js",
    "demo:failure": "node src/demo.js --fail",
    "titles": "node src/print-done-titles.js",
    "mcp": "node src/mcp-server.js",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.js",
    "test:python": "python tests/test-edge-tts-retries.py",
    "audit:source": "node scripts/audit-source.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@notionhq/client": "3.1.3",
    "dotenv": "16.6.1",
    "sanitize-filename": "1.6.3",
    "zod": "4.6.7"
  }
}
